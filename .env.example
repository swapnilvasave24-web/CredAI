# CredAI environment configuration
# Copy this file to .env and fill in real values before running in any
# shared or production-like environment. Never commit a real .env file.

# --- Database ---
# For local dev without Docker, SQLite is used automatically if DATABASE_URL
# is unset. For Docker Compose / production, use Postgres:
DATABASE_URL=postgresql+psycopg2://credai:credai_dev_password@localhost:5432/credai
POSTGRES_USER=credai
POSTGRES_PASSWORD=credai_dev_password
POSTGRES_DB=credai

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-value-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Kaggle (only needed for scripts/download_data.py, real dataset) ---
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# --- Frontend ---
# Base path the frontend calls for the API. In Docker Compose this is
# proxied through nginx at /api; for local `npm run dev` it's proxied by Vite.
VITE_API_URL=/api
